{
  "id": "user",
  "name": "用户管理",
  "type": "table",
  "config": {
    "fields": [
      { "key": "id", "label": "ID", "type": "text", "hidden": true },
      { "key": "name", "label": "姓名", "type": "text" },
      { "key": "email", "label": "邮箱", "type": "text" },
      {
        "key": "role",
        "label": "角色",
        "type": "enum", // 状态显示
        "enums": [
          [
            "admin",
            {
              "type": "error",
              "text": "管理员"
            }
          ],
          [
            "editor",
            {
              "type": "warning",
              "text": "编辑者"
            }
          ],
          [
            "user",
            {
              "type": "info",
              "text": "普通用户"
            }
          ]
        ]
      },
      {
        "key": "status",
        "label": "状态",
        "type": "enum", // 状态显示
        "enums": [
          [
            "active",
            {
              "type": "success",
              "text": "激活"
            }
          ],
          [
            "inactive",
            {
              "type": "default",
              "text": "未激活"
            }
          ],
          [
            "pending",
            {
              "type": "warning",
              "text": "待审核"
            }
          ]
        ]
      },
      {
        "key": "createdAt",
        "label": "创建时间",
        "type": "text"
      }
    ],
    "filterFileds": ["id", "name", "email"], // 可搜索筛选的字段
    "writeableFields": ["name", "email", "role", "status"], // 新增/修改弹框中展示的字段
    "api": {
      "query": {
        "url": "/api/users",
        "method": "GET"
      },
      "create": {
        "url": "/api/users",
        "method": "POST"
      },
      "update": {
        "url": "/api/users/:id",
        "method": "PUT"
      },
      "delete": {
        "url": "/api/users/:id",
        "method": "DELETE"
      },
      "batchDelete": {
        "url": "/api/users/batch",
        "method": "DELETE"
      },
      "export": {
        "url": "/api/users/export",
        "method": "GET",
        "responseType": "blob"
      },
      "import": {
        "url": "/api/users/import",
        "method": "GET",
        "responseType": "blob"
      }
    }
  }
}
